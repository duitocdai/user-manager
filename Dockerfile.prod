#======= STAGE 1 : BUILD GO BINARY
FROM golang:1.26.4-alpine AS builder
RUN apk update && apk add --no-cache git curl
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -o main ./cmd/api

#======= STAGE 2 : RUN TIME CONTAINER
FROM alpine:3.19

WORKDIR /app

COPY --from=builder /app/main .

EXPOSE 8080

CMD ["./main"]


